# Every setting is optional. Copy this file to .env and uncomment what you change.

# Port the server listens on.
# PORT=3000

# Amazon Bedrock model the agent uses.
# MODEL_ID=global.anthropic.claude-sonnet-4-6

# AWS Region for Amazon Bedrock. Credentials come from the default AWS credential
# chain: environment variables, the shared config file, SSO, or an IAM role.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
